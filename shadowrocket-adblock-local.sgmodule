[MITM]
hostname = %APPEND% pan.baidu.com, sofire.baidu.com, ndstatic.cdn.bcebos.com, staticsns.cdn.bcebos.com, issuecdn.baidupcs.com, update.pan.baidu.com, rp.hpplay.cn, cn-acs.m.cainiao.com, m*.amap.com, m5.amap.com, optimus-ads.amap.com, ems.youku.com, interface.music.163.com, interface3.music.163.com, interface9.music.163.com, music.163.com, appconf.mail.163.com, client.mail.163.com
