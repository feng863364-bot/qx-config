#!name=本地去广告合集
#!desc=百度网盘、菜鸟、高德地图、网易云音乐、网易邮箱去广告重写，由 QX 本地合集转换（2026-11-18）。仅去广告，不含会员解锁。
#!category=去广告
#!system=ios

[URL Rewrite]
